# Copy this file to .env and fill in real values. Never commit .env (NFR-08).

# PostgreSQL connection string. If using the included docker-compose.yml
# for local dev, this default matches it exactly.
DATABASE_URL="postgresql://dispute_guard:dispute_guard@localhost:5432/dispute_guard?schema=public"

# Used to sign session JWTs. Generate a real one with:
#   openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string"

# Shared secret the scheduler (or scripts/run-cron-local.ts) must send
# as the x-cron-secret header when calling POST /api/cron/run.
CRON_SECRET="replace-with-another-long-random-string"

# Used by scripts/run-cron-local.ts to know where the app is running.
APP_URL="http://localhost:3000"
