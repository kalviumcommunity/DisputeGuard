generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DisputeStatus {
  ACTION_REQUIRED
  UNDER_REVIEW
  RESOLVED
  ESCALATED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         String    @default("user")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  disputes     Dispute[]
}

model Dispute {
  id               String        @id @default(cuid())
  reference        String        @unique
  title            String
  amountMinor      Int
  currency         String        @default("INR")
  status           DisputeStatus @default(ACTION_REQUIRED)
  priority         Priority      @default(MEDIUM)
  responseDeadline DateTime
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  merchantId       String
  merchant         User          @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([merchantId, status, responseDeadline])
}