{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  },
  "scripts": {
    "db:seed": "prisma db seed",
    "test:seed": "node --import tsx --test tests/development-seed.test.ts",
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "test:session": "node --test tests/session.test.cjs",
    "test:schema": "node --import tsx --test tests/prisma-schema.test.ts",
    "demo:schema": "tsx scripts/prisma-schema-demo.ts",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-libsql": "7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "bcryptjs": "^3.0.3",
    "next": "16.3.2",
    "next-auth": "^4.24.15",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@electric-sql/pglite-socket": "0.1.3",
    "@next/env": "16.3.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  }
}
