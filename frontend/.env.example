# .env.example (safe to commit - contains no real secrets)

# Server-only secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required: set a generated value in .env.local. Never commit the real secret.
NEXTAUTH_SECRET=
# Secure session cookies require HTTPS, including the local demo.
NEXTAUTH_URL=https://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATABASE_URL=postgresql://username:password@localhost:5432/database_name
API_SECRET_KEY=sk_test_your_key_here
JWT_SECRET=your_jwt_secret_here
STRIPE_SECRET_KEY=sk_test_stripe_key_here

# Public variables - safe for browser
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_NAME=My App
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_stripe_key_here
NEXT_PUBLIC_ANALYTICS_ID=GA-your_analytics_id_here
